{
  "expo": {
    "name": "CardScan AI",
    "slug": "cardscan-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121214"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cardscanai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "CardScan AI uses the camera to capture business cards for contact extraction.",
        "NSPhotoLibraryUsageDescription": "CardScan AI accesses your photo library to import business card images.",
        "NSContactsUsageDescription": "CardScan AI saves extracted contacts directly to your phone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121214"
      },
      "package": "com.cardscanai.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121214",
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CardScan AI uses the camera to capture business cards."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CardScan AI accesses photos to import business card images."
        }
      ],
      "expo-contacts",
      "expo-secure-store",
      "expo-font"
    ],
    "scheme": "cardscanai",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "40d17f51-d614-43e0-9981-dd9195b84a9d"
      }
    }
  }
}
