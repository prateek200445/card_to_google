# ── OpenRouter ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_PRIMARY_MODEL=baidu/qianfan-ocr-fast:free
OPENROUTER_FALLBACK_1=google/gemma-3-12b-it:free
OPENROUTER_FALLBACK_2=meta-llama/llama-3.2-11b-vision-instruct:free

# ── Concurrency ───────────────────────────────────────────────────────────
MAX_CONCURRENCY=6
REQUEST_TIMEOUT=45.0

# ── Google Sheets ─────────────────────────────────────────────────────────
GOOGLE_SHEET_ID=your_google_sheet_id_or_url_here
GOOGLE_SHEET_TAB=Sheet1

# LOCAL DEV: path to credentials JSON file
GOOGLE_CREDENTIALS_PATH=credentials.json

# CLOUD DEPLOY (Render etc): paste the entire credentials.json content as one line
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── App ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_BATCH_SIZE=25
